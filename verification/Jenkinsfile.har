pipeline {
    agent { label 'linux-build' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
    }
    parameters {
        string(name: 'SOURCE_COMMIT', defaultValue: '', description: 'Wechat 仓库已推送的完整 40 位提交；公开消费时须为 HAR tag 提交')
        string(name: 'VERIFY_TAG', defaultValue: '', description: '可选：精确公开 HAR tag，例如 har-0.1.8-rc.1；留空则仅构建')
        string(name: 'VERIFY_HAR_SHA', defaultValue: '', description: '公开消费时填写 har-release-checksums.txt 已冻结的 SHA-256')
    }
    stages {
        stage('Checkout exact component') {
            steps {
                script {
                    if (!(params.SOURCE_COMMIT ==~ /[0-9a-f]{40}/)) { error '必须提供完整提交' }
                    if (params.VERIFY_TAG.isEmpty() != params.VERIFY_HAR_SHA.isEmpty()) { error '公开消费必须同时提供 tag 和冻结摘要' }
                    checkout([$class: 'GitSCM', branches: [[name: params.SOURCE_COMMIT]],
                        userRemoteConfigs: [[url: 'https://github.com/gycrosskit/wechat.git']],
                        extensions: [[$class: 'CleanBeforeCheckout']]])
                }
                sh 'test "$(git rev-parse HEAD)" = "$SOURCE_COMMIT"'
            }
        }
        stage('Build and check HAR') {
            when { expression { !params.VERIFY_TAG } }
            steps { sh 'bash scripts/package-har.sh' }
        }
        stage('Consume exact public HAR') {
            when { expression { params.VERIFY_TAG } }
            steps { sh 'bash scripts/verify-public-har.sh' }
        }
    }
    post { success { archiveArtifacts artifacts: 'build/release-candidate/*,build/public-har/proof.json,build/public-har/source-commit.txt', fingerprint: true } }
}
